# API Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
API_VERSION=v1

# JWT Configuration
JWT_SECRET=change-me-in-production-use-strong-random-secret
JWT_EXPIRY=7d

# Firebase Configuration
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-auth-domain
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-storage-bucket
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Firebase Admin SDK (for server-side operations)
# Download service account key from Firebase Console
# Place it in backend/config/firebase-service-account.json
# Or use environment variable for the JSON content
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./config/firebase-service-account.json

# Security Configuration
ENCRYPTION_ALGORITHM=AES-256-GCM
PBKDF2_ITERATIONS=100000
SESSION_TIMEOUT=900000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
ENABLE_BIOMETRIC_AUTH=true
ENABLE_CRASH_REPORTING=true
ENABLE_ANALYTICS=false

# Development
DEV_MODE=true
ENABLE_FLIPPER=false

# Monitoring (optional)
# SENTRY_DSN=your-sentry-dsn
# NEW_RELIC_LICENSE_KEY=your-newrelic-key
